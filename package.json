{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "[ ! -f scripts/build-data.mjs ] || (node scripts/build-data.mjs && node scripts/build-images.mjs)",
    "dev": "npm run data && astro dev",
    "build": "npm run data && astro check && astro build && ([ ! -f scripts/build-data.mjs ] || node scripts/build-data.mjs --verify-dist)",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
