---
// The film leader: 3, 2, 1, then the picture. Plays once on arrival.
---
<div class="leader" aria-hidden="true">
  <div class="ring">
    <i class="sweep"></i>
    <i class="cross"></i>
    <span class="n n3">3</span>
    <span class="n n2">2</span>
    <span class="n n1">1</span>
  </div>
</div>

<style>
  .leader {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    background: #0b0b0c;
    animation: leader-out 0.5s ease 2.55s forwards;
  }
  .leader.skip { display: none; }
  .ring {
    position: relative;
    width: min(56vmin, 420px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid #5a5853;
    box-shadow: 0 0 0 10px #0b0b0c, 0 0 0 12px #3a3935;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .sweep {
    position: absolute;
    inset: 0;
    background: conic-gradient(rgb(236 232 223 / 0.16) var(--sweep, 0deg), transparent 0);
    animation: sweep 0.8s linear 3;
  }
  .cross {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(#5a5853, #5a5853) center / 2px 100% no-repeat,
      linear-gradient(#5a5853, #5a5853) center / 100% 2px no-repeat;
  }
  .n {
    grid-area: 1 / 1;
    font-size: min(30vmin, 240px);
    font-weight: 300;
    line-height: 1;
    color: #ece8df;
    opacity: 0;
    z-index: 1;
  }
  .n3 { animation: flash 0.8s steps(1) 0s 1; }
  .n2 { animation: flash 0.8s steps(1) 0.8s 1; }
  .n1 { animation: flash 0.8s steps(1) 1.6s 1; }
  @property --sweep { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes sweep { to { --sweep: 360deg; } }
  @keyframes flash { 0% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes leader-out { to { opacity: 0; visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) {
    .leader { display: none; }
  }
</style>

<script>
  // Arriving mid-film (back button, chapter link) skips the leader.
  const leader = document.querySelector<HTMLElement>('.leader');
  if (leader && (scrollY > 10 || location.hash)) leader.classList.add('skip');
  addEventListener('scroll', () => leader?.classList.add('skip'), { once: true, passive: true });
</script>
