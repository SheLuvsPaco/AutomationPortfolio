---
// A single workflow as a row of stations, each holding the real outline of
// its stretch of the graph, with the loop that sends the run to the next item.
// Plays in "The fix", timed by scene progress.
type Thumb = { w: number; h: number; boxes: string };
export interface RowStop { step: string; sub: string; thumb: Thumb }
interface Props {
  stops: RowStop[];
  loop?: string;
}
const { stops, loop } = Astro.props;

const fit = (t: Thumb, [x, y, w, h]: number[]) => {
  const k = Math.min(w / t.w, h / t.h);
  return { k, x: x + (w - t.w * k) / 2, y: y + (h - t.h * k) / 2 };
};
const n = stops.length;
// Wide: one row, the loop running back underneath.
const W = 1200, CW = (W - (n - 1) * 26) / n, CH = 196;
const wide = stops.map((s, i) => ({ ...s, x: i * (CW + 26), art: fit(s.thumb, [i * (CW + 26) + 14, 70, CW - 28, CH - 84]) }));
// Tall (phones): one column, the loop running back up the right side.
const TW = 300, TH = 66, TG = 12;
const tall = stops.map((s, i) => ({ ...s, y: i * (TH + TG), art: fit(s.thumb, [TW - 120, i * (TH + TG) + 10, 108, TH - 20]) }));
const tallH = n * (TH + TG) - TG;
const t = (i: number) => `--a:${(0.1 + i * 0.08).toFixed(2)};--b:${(0.15 + i * 0.08).toFixed(2)}`;
const loopT = `--a:${(0.12 + n * 0.08).toFixed(2)};--b:${(0.2 + n * 0.08).toFixed(2)}`;
---
<div class="rm">
  <svg class="wide" viewBox={`-6 -6 ${W + 12} ${CH + (loop ? 96 : 12)}`} aria-label={stops.map((s, i) => `${i + 1}. ${s.step}: ${s.sub}`).join('. ')}>
    {wide.slice(0, -1).map((c, i) => <path class="w in" style={t(i + 1)} d={`M${c.x + CW + 3} 34 h20`} />)}
    {wide.map((c, i) => (
      <g class="st" style={t(i)}>
        <rect class="card" x={c.x} y="0" width={CW} height={CH} rx="12" />
        <text class="st-t" x={c.x + 14} y="30">{i + 1} · {c.step}</text>
        <text class="st-s" x={c.x + 14} y="50">{c.sub}</text>
        <g transform={`translate(${c.art.x} ${c.art.y}) scale(${c.art.k})`}><path class="wf-b" d={c.thumb.boxes} /></g>
      </g>
    ))}
    {loop && (
      <>
        <path class="loop draw" pathLength="1" style={loopT} d={`M${wide[n - 1].x + CW / 2} ${CH + 4} C ${wide[n - 1].x + CW / 2} ${CH + 70}, ${CW / 2} ${CH + 70}, ${CW / 2} ${CH + 10}`} />
        <path class="tip in" style={loopT} d={`M${CW / 2 - 6} ${CH + 20} L${CW / 2} ${CH + 8} L${CW / 2 + 6} ${CH + 20}`} />
        <text class="loop-t in" style={loopT} x={W / 2} y={CH + 66} text-anchor="middle">{loop}</text>
      </>
    )}
  </svg>
  <svg class="tall" viewBox={`-4 -4 ${TW + 60} ${tallH + 8}`} aria-hidden="true">
    {tall.slice(0, -1).map((c, i) => <path class="w in" style={t(i + 1)} d={`M40 ${c.y + TH + 1} v${TG - 2}`} />)}
    {tall.map((c, i) => (
      <g class="st" style={t(i)}>
        <rect class="card" x="0" y={c.y} width={TW} height={TH} rx="11" />
        <text class="st-t sm" x="14" y={c.y + 28}>{i + 1} · {c.step}</text>
        <text class="st-s sm" x="14" y={c.y + 48}>{c.sub}</text>
        <g transform={`translate(${c.art.x} ${c.art.y}) scale(${c.art.k})`}><path class="wf-b" d={c.thumb.boxes} /></g>
      </g>
    ))}
    {loop && (
      <>
        <path class="loop draw" pathLength="1" style={loopT} d={`M${TW + 4} ${tall[n - 1].y + TH / 2} C ${TW + 46} ${tall[n - 1].y + TH / 2}, ${TW + 46} ${TH / 2}, ${TW + 10} ${TH / 2}`} />
        <path class="tip in" style={loopT} d={`M${TW + 20} ${TH / 2 - 6} L${TW + 8} ${TH / 2} L${TW + 20} ${TH / 2 + 6}`} />
      </>
    )}
  </svg>
</div>

<style>
  .rm { width: min(1180px, 100%); }
  .rm svg { width: 100%; height: auto; overflow: visible; }
  .tall { display: none; }
  .st, .in, .draw { --t: clamp(0, (var(--p) - var(--a)) / (var(--b) - var(--a)), 1); }
  .st { --h: min(var(--t), clamp(0, (var(--b) + 0.08 - var(--p)) / 0.08, 1)); opacity: calc(0.18 + var(--t) * 0.82); }
  .card { fill: color-mix(in srgb, #26150f calc(var(--t) * 100%), var(--night-2)); stroke: color-mix(in srgb, var(--live) calc(var(--t) * 100%), #2a2d33); stroke-width: calc(1.5px + var(--h) * 2px); }
  .st-t { font: 500 18px var(--sans); font-stretch: 112%; fill: var(--text); }
  .st-t.sm { font-size: 16px; }
  .st-s { font: 11.5px var(--mono); fill: var(--text-3); }
  .st-s.sm { font-size: 11px; }
  .wf-b { fill: color-mix(in srgb, var(--live) calc(var(--t) * 90%), #4a4d55); }
  .w { stroke: var(--live); stroke-width: 2; opacity: var(--t); }
  .loop { fill: none; stroke: var(--live); stroke-width: 2.5; }
  .tip { fill: none; stroke: var(--live); stroke-width: 2.5; opacity: var(--t); }
  .loop-t { font: italic 18px var(--serif); fill: var(--text); opacity: var(--t); }
  @media (max-width: 760px) {
    .wide { display: none; }
    .tall { display: block; }
    .rm { width: min(340px, 100%); }
  }
</style>
