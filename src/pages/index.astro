  /* House lights down when a film is chosen. */
  :global(html.dim) .palace { opacity: 0; transition: opacity 0.38s ease; }

  /* -------------------------------------------------------------- desktop */
  /* A narrower crown sits on the stage like a pediment; the poster takes
