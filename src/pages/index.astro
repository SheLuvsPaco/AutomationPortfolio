  }
  .pillar.l { left: 0; }
  .pillar.r { right: 0; }
  .pillar { display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; padding: 18px 0; }
  .pillar .lamp { width: 8px; height: 8px; }
  .screen {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 12%;
    bottom: 6%;
    background: #050506;
    overflow: hidden;
    box-shadow: 0 0 0 1px #2a1d10, 0 0 80px rgb(255 220 170 / 0.08);
    animation: screen-on 0.8s 1.9s ease both;
  }
  @keyframes screen-on { from { filter: brightness(0.2); } to { filter: none; } }
  .curtain {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 4;
