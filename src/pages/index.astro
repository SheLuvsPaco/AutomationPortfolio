  }
  .curtain.l { left: 3.4%; transform-origin: left center; --tx: scaleX(0.2); }
  .curtain.r { right: 3.4%; transform-origin: right center; --tx: scaleX(0.2); }
  @keyframes part { from { transform: none; } to { transform: var(--tx); } }
  .valance { position: absolute; z-index: 6; left: 0; right: 0; top: -2px; width: 100%; height: 15%; min-height: 54px; }
  .fringe { fill: none; stroke: var(--gold); stroke-width: 9; stroke-dasharray: 1.6 3.4; opacity: 0.9; }
  .lip {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: -14px;
    height: 16px;
    background: linear-gradient(var(--gold-hi), var(--gold) 40%, var(--gold-lo));
