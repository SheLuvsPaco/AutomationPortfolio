  @keyframes chase { 50% { fill: var(--m-lo); filter: none; } }
  .sign-pre { font: italic 400 21px var(--serif); fill: var(--m-hi); letter-spacing: 0.14em; }
  .sign-name { font: 600 54px var(--sans); font-stretch: 125%; letter-spacing: 0.18em; fill: var(--sign); filter: drop-shadow(0 0 10px color-mix(in srgb, var(--l) 80%, transparent)); }

  /* The stage: pillars, screen, curtains, valance, lip. */
  .proscenium {
    position: absolute;
    z-index: 3;
    left: 50%;
