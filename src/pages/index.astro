  .p-status { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); }
  .soon .p-status { color: var(--text-3); }
  .p-title { font-size: clamp(0.95rem, 0.6rem + 0.8vw, 1.25rem); letter-spacing: 0.08em; font-weight: 400; line-height: 1.15; }
  .p-tag { font-family: var(--serif); font-style: italic; font-size: 0.92rem; color: var(--text-2); }
  .billing { margin-top: 6px; font-size: 0.54rem; letter-spacing: 0.06em; line-height: 1.35; text-transform: uppercase; color: var(--text-3); }
