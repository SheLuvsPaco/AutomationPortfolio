  .soon-tag { font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); border: 1px solid #2a2c31; padding: 8px 14px; border-radius: 999px; }
  .reel { position: absolute; right: 16px; bottom: 12px; z-index: 2; display: flex; gap: 4px; }
