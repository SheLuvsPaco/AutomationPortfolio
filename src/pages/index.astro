  /* The rack heading: gold rules either side. */
  .rack { display: flex; align-items: center; gap: 22px; max-width: 1400px; margin: 0 auto clamp(36px, 4vw, 56px); font: 600 0.78rem var(--sans); letter-spacing: 0.42em; text-transform: uppercase; color: var(--gold-hi); text-shadow: 0 0 18px rgb(255 190 90 / 0.5); }
  .rack::before, .rack::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--gold)); }
