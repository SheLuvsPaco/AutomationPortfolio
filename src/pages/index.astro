  .poster {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    background: #07080a;
    box-shadow: 0 0 0 5px #1a0e05, 0 0 0 7px var(--gold), 0 0 0 9px var(--gold-lo), 0 18px 50px -12px rgb(0 0 0 / 0.9), 0 0 50px -10px rgb(255 200 120 / 0.25);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .poster:hover, .poster:focus-visible, .poster.play { --play: running; }
  a.poster:hover, a.poster:focus-visible { transform: translateY(-6px); box-shadow: 0 0 0 5px #1a0e05, 0 0 0 7px var(--gold-hi), 0 0 0 9px var(--gold), 0 30px 60px -20px rgb(0 0 0 / 0.9), 0 0 70px -6px var(--accent); }
  .plate { padding: 4px 14px; border-radius: 2px; background: linear-gradient(var(--gold-hi), var(--gold) 50%, var(--gold-lo)); font: 600 0.58rem var(--sans); letter-spacing: 0.24em; text-transform: uppercase; color: #2a1a06; }
  .p-art { position: absolute; inset: 0; }
  .p-art :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .p-copy { position: absolute; inset: auto 0 0 0; padding: 64px 16px 14px; display: grid; gap: 6px; background: linear-gradient(transparent, #07080a 38%); }
  .designed .p-art :global(img) { transition: filter 0.45s var(--ease); }
