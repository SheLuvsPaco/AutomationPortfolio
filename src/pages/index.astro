<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Trailers rotate on the big screen; a hovered poster takes over the screen.
  const trailers = [...document.querySelectorAll<HTMLElement>('.trailer')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.reel button')];
  const house = document.querySelector<HTMLElement>('.house')!;
  let current = Math.max(0, trailers.findIndex((t) => t.classList.contains('on')));
  let timer = 0;
  const show = (i: number) => {
    current = (i + trailers.length) % trailers.length;
    trailers.forEach((t, k) => {
      t.classList.toggle('on', k === current);
      t.setAttribute('aria-hidden', String(k !== current));
      t.querySelectorAll<HTMLElement>('.watch').forEach((w) => w.setAttribute('tabindex', k === current ? '0' : '-1'));
    });
    tabs.forEach((b, k) => b.setAttribute('aria-selected', String(k === current)));
    house.dataset.theme = trailers[current].dataset.theme;
  };
  const step = (d: number) => { show(current + d); rotate(); };
  document.querySelector('.nav.prev')!.addEventListener('click', () => step(-1));
  document.querySelector('.nav.next')!.addEventListener('click', () => step(1));
  // Sideways scroll (trackpad or shift+wheel) over the theatre changes the film.
  let acc = 0;
  let lock = 0;
  house.addEventListener('wheel', (e) => {
    const dx = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : 0;
    if (!dx) return;
    e.preventDefault(); // stops the browser's swipe-to-go-back
    if (performance.now() < lock) return;
    acc += dx;
    if (Math.abs(acc) > 40) { step(Math.sign(acc)); acc = 0; lock = performance.now() + 650; }
  }, { passive: false });
  // Phones: swipe across the screen.
  let x0 = 0;
  let y0 = 0;
  const screen = document.querySelector<HTMLElement>('.screen')!;
  screen.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
  screen.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    const dy = e.changedTouches[0].clientY - y0;
    if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) step(dx < 0 ? 1 : -1);
  }, { passive: true });
  addEventListener('keydown', (e) => {
    if (house.getBoundingClientRect().bottom < 120) return;
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });
  const rotate = () => {
    clearInterval(timer);
    if (!reduced) timer = window.setInterval(() => show(current + 1), 6500);
  };
  tabs.forEach((b, i) => b.addEventListener('click', () => { show(i); rotate(); }));
  const hoverable = (sel: string) => document.querySelectorAll<HTMLElement>(sel).forEach((p, i) => {
    p.addEventListener('mouseenter', () => { show(i); clearInterval(timer); });
    p.addEventListener('mouseleave', rotate);
  });
  hoverable('.case .poster');
  rotate();
  document.addEventListener('visibilitychange', () => (document.hidden ? clearInterval(timer) : rotate()));

  // Phones: the poster in the centre of the carousel plays.
  if (matchMedia('(max-width: 860px)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => e.target.classList.toggle('play', e.isIntersecting)), { threshold: 0.75 });
    document.querySelectorAll('.poster').forEach((p) => io.observe(p));
  }

  // Choosing a film: house lights down, the title carries into the film.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[data-film]');
    if (!link || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    const title = (link.closest('.trailer, .poster') ?? link).querySelector<HTMLElement>('[data-title]');
    if (title) title.style.viewTransitionName = 'film-title';
    if (reduced) return void (location.href = link.href);
    document.documentElement.classList.add('dim');
    setTimeout(() => (location.href = link.href), 380);
  });
  // Coming back with the back button: house lights up again.
  addEventListener('pageshow', () => document.documentElement.classList.remove('dim'));
</script>
