  }
  /* Footlights along the lip. */
  .lip { display: flex; justify-content: space-around; align-items: flex-start; padding-inline: 3%; }
  .lip .lamp { width: 7px; height: 7px; margin-top: -9px; }

  /* Trailers on the screen. */
  .trailer { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 0.9s ease, visibility 0.9s; }
  .trailer.on { opacity: 1; visibility: visible; --play: running; }
  /* Its own layer: the poster can sit over the dimming without lifting it over the text. */
  .t-art { position: absolute; inset: 0; z-index: 0; }
