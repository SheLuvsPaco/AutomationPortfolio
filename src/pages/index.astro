    .t-poster-art :global(.t-poster) { left: 50%; right: auto; top: 5%; height: 56%; translate: -50% 0; }
    .t-copy { left: 16px; right: 16px; bottom: 16px; max-width: none; gap: 6px; justify-items: center; text-align: center; }
