    .proscenium { top: calc(var(--ct) + var(--cw) * 0.155); bottom: clamp(70px, 11vh, 110px); width: min(1260px, 96vw); }
    .screen { left: 12.5%; right: 12.5%; top: 11%; bottom: 4%; }
    .curtain.l, .curtain.r { --tx: scaleX(0.15); }
    .t-art::after { background: radial-gradient(ellipse 34% 90% at 50% 50%, transparent 60%, rgb(5 5 6 / 0.55)), linear-gradient(90deg, rgb(5 5 6 / 0.9), rgb(5 5 6 / 0.35) 30%, rgb(5 5 6 / 0.35) 70%, rgb(5 5 6 / 0.9)); }
    .t-poster-art :global(.t-poster) { right: auto; left: 50%; translate: -50% 0; top: 5%; height: 90%; box-shadow: 0 0 0 1px rgb(255 230 180 / 0.12), 0 30px 90px -10px rgb(0 0 0 / 0.95), 0 0 120px -20px var(--accent); }
    /* The poster is 90% of the screen's height at 2:3, so it is 60cqh wide;
       each side column gets what's left of its half. */
    .screen { container-type: size; }
    .t-copy { left: 4cqw; right: auto; top: 50%; bottom: auto; translate: 0 -50%; max-width: calc(50cqw - 30cqh - 7cqw); }
    .t-copy .watch { display: none; }
    .t-meta { position: absolute; right: 4cqw; top: 50%; translate: 0 -50%; display: grid; gap: 14px; justify-items: end; text-align: right; max-width: calc(50cqw - 30cqh - 7cqw); }
    .t-bill { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.16em; line-height: 1.7; text-transform: uppercase; color: #b9a27c; }
    .t-nodes { font-family: var(--mono); font-size: 0.72rem; color: var(--accent); }
    .t-meta .watch { white-space: nowrap; padding: 11px clamp(14px, 1.6cqw, 20px); font-size: clamp(0.7rem, 1.2cqw, 0.82rem); }
    .t-status { white-space: nowrap; font-size: clamp(0.56rem, 0.9cqw, 0.66rem); }
    /* Sized to its column, so a long word like RECEPTIONIST never reaches the poster. */
    .t-title { font-size: max(1rem, min(2.6rem, 3.4cqw, calc((43cqw - 30cqh) / 11.5))); }
  }
  @media (min-width: 861px) and (max-width: 1180px) {
