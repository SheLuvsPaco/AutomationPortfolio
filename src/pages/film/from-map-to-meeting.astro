---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Film from '../../layouts/Film.astro';
import Icon from '../../components/Icon.astro';
import LeadMap, { type Stop } from '../../components/LeadMap.astro';
import { index } from '../../lib/data';
import film from '../../data/generated/leads.film.json';
import fx from '../../film/leads-fixtures.json';

const T = film.thumbs;
const STOPS: Stop[] = [
  { step: 'Find', sub: 'towns · places', thumbs: [T['lead-finder'], T['duplicate-cleanup']] },
  { step: 'Owner', sub: 'AI research · email', thumbs: [T['decision-maker'], T['email-finder']] },
  { step: 'Audit', sub: 'screenshots · AI', thumbs: [T.audit] },
  { step: 'Inbox', sub: 'who hosts it?', thumbs: [T['inbox-filter']] },
  { step: 'Outreach', sub: 'email + follow-ups', thumbs: [T.outreach] },
  { step: 'Call', sub: 'research · AI voice', thumbs: [T.call] },
];
const lead = fx.lead;
const wfs = index.filter((w) => w.folder === 'lead-machine');
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/shots/lead-*.png', { eager: true });
const shotOf = (slug: string) => shots[`../../assets/shots/lead-${slug}.png`].default;

// Owner: the real search ladder, filled with the film's invented lead.
const ladder = film.owner.ladder.map((q) => q
  .replace('<Business Name>', lead.business).replace('<postcode>', 'LS7 3PD')
  .replace('<domain>', lead.domain).replace(/<phone number[^>]*>/, lead.phone));
const short = (m: string) => m.split('/').pop()!;

// Audit: what each pass leaves standing.
const chosen = 0;
const passes = film.audit.passes;

// Send: the first email, with the audit's words picked out.
const A = fx.audit;
const phrases = [A.problem, A.reason, A.consequence, A.fix];
const marked = (text: string) => {
  const out: { t: string; m: boolean }[] = [];
  let rest = text;
  while (rest) {
    const hits = phrases.map((p) => [rest.indexOf(p), p] as const).filter(([i]) => i >= 0).sort((a, b) => a[0] - b[0]);
    if (!hits.length) { out.push({ t: rest, m: false }); break; }
    const [i, p] = hits[0];
    if (i > 0) out.push({ t: rest.slice(0, i), m: false });
    out.push({ t: p, m: true });
    rest = rest.slice(i + p.length);
  }
  return out;
};
const first = film.outreach.emails[0];
const follow = film.outreach.emails.slice(1).map((e) => {
  const line = e.body.find((b, i) => i > 0 || !/^(Hi|Hey) \w+,$/.test(b))!.replace(/^(Hey|Hi) \w+, /, '').split(/(?<=[.?])\s/)[0];
  const words = line.split(' ');
  return words.length > 9 ? `${words.slice(0, 8).join(' ').replace(/\s*&$/, '')}…` : line;
});
const [sMin, sMax] = film.outreach.spacing;
// Replies: the day each message goes out, from the real waits.
const days = film.outreach.waits.reduce<number[]>((acc, w) => [...acc, acc[acc.length - 1] + Number.parseInt(w)], [0]);

const liveSource = film.live;
const liveFixtures = { addresses: fx.addresses, sitemap: fx.sitemap, notSitemap: fx.notSitemap, threads: fx.threads, sends: fx.queue.length };

const STEPS = STOPS.map((s) => s.step);
const SCENES = [
  ['open', 130], ['problem', 280], ['fix', 320],
  ['town', 300, 'Find'], ['scan', 300, 'Find'], ['owner', 330, 'Owner'], ['email', 260, 'Owner'],
  ['pages', 320, 'Audit'], ['verify', 340, 'Audit'], ['inbox', 260, 'Inbox'],
  ['send', 320, 'Outreach'], ['replies', 340, 'Outreach'], ['call', 360, 'Call'],
  ['machine', 280], ['end', 150],
] as const;
const io = (a: number, b: number, c = 2, dd = 2) => `--a:${a};--b:${b};--c:${c};--d:${dd}`;
const sheet = [['Tarnside Roofers'], ['Ashby Gable Co.'], ['Ironleaf Roofing'], ['Wrenmoor Roofs'], ['Copperdale Roofing']];
---
<Film
  title="From Map to Meeting · Plamen Iliev"
  film="From Map to Meeting"
  description="A short film about seven n8n workflows that find local businesses, research their owners, audit their websites, and book meetings by email or by phone."
  runtime={230}
  steps={STEPS}
>
  <div class="stage">
    <section class="layer hold-start on" id="open">
      <div class="center">
        <div class="o-wrap">
          <h1 class="title-x o-title" style="view-transition-name: film-title; --em: 17.1; --em-m: 9.8"><span>From Map</span> <span>to Meeting</span></h1>
          <p class="narr io" style={io(0.25, 0.4)}>A short film about a pipeline that turns a town on a map into booked meetings.</p>
          <p class="invented io" style={io(0.4, 0.55)}>Fictional businesses. Real machines.</p>
        </div>
      </div>
      <p class="cue">Scroll to play</p>
    </section>

    <!-- The problem -->
    <section class="layer" id="problem">
      <p class="kicker io" style={io(0.02, 0.08)}>The problem</p>
      <div class="center safe">
        <div class="pb">
          <div class="grid-sheet in" style={io(0.04, 0.1)}>
            <p class="gs-r gs-h"><span>Business</span><span>Owner</span><span>Email</span></p>
            {sheet.map(([b], i) => (
              <p class="gs-r in" style={io(0.08 + i * 0.03, 0.12 + i * 0.03)}><span>{b}</span><span class="q in hit-text" style={io(0.26 + i * 0.02, 0.3 + i * 0.02)}>?</span><span class="q in hit-text" style={io(0.27 + i * 0.02, 0.31 + i * 0.02)}>?</span></p>
            ))}
          </div>
          <div class="spam in" style={io(0.5, 0.56)}>
            <p class="sp-tabs"><span>Inbox</span><b class="in hit-text" style={io(0.66, 0.72)}>Spam · 1</b></p>
            <div class="sp-mail">
              <p class="sp-from">Web Agency</p>
              <p class="sp-sub">Dear Sir/Madam, grow your business online</p>
              <p class="sp-body">We are a leading digital agency offering websites, SEO and…</p>
            </div>
            <p class="sp-flag in" style={io(0.66, 0.72)}>moved to spam</p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.44, 0.48)}>Local businesses are everywhere. Their owners’ names and emails aren’t.</p>
        <p class="narr io" style={io(0.52, 0.58, 0.93, 0.97)}>And the generic pitch lands straight in spam.</p>
      </div>
    </section>

    <!-- The fix -->
    <section class="layer" id="fix">
      <p class="kicker io" style={io(0.02, 0.08)}>The fix · seven real workflows</p>
      <div class="center safe">
        <LeadMap stops={STOPS} mode="big" />
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.5, 0.56)}>Seven workflows, one pipeline. From a pin on a map to a meeting.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Email if there’s an address. A phone call if there isn’t.</p>
      </div>
    </section>

    <!-- 1 · Find: the town picker -->
    <section class="layer" id="town">
      <div class="center safe">
        <div class="tw">
          <div class="tw-row">
            <div class="mem in" style={io(0.04, 0.1)}>
              <p class="who">Its memory · towns already searched</p>
              <p class="mem-l">{fx.searched.map((c, i) => <span class="in" style={io(0.06 + i * 0.008, 0.09 + i * 0.008)}>{c}</span>)}</p>
            </div>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.15, 0.2)} /></svg>
            <div class="agent in hit" style={io(0.18, 0.24)}>
              <Icon name="flow" />
              <b>AI agent</b>
              <span>picks the next town</span>
              <q>{film.town.rule.replace(/^.*?(It must be)/, '$1')}</q>
            </div>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.26, 0.3)} /></svg>
            <dl class="pick">
              {[['Trade', fx.pick.trade], ['City', fx.pick.city], ['Country', fx.pick.country]].map(([k, v], i) => (
                <div class="in" style={io(0.3 + i * 0.03, 0.34 + i * 0.03)}><dt>{k}</dt><dd class="hit-text">{v}</dd></div>
              ))}
            </dl>
          </div>
          <div class="chain">
            <p class="who in" style={io(0.54, 0.58)}>If a model fails, the next one takes over · all free</p>
            <p class="mdls">
              {film.town.models.map((m, i) => (
                <>
                  {i > 0 && <i class="in" style={io(0.58 + i * 0.05, 0.6 + i * 0.05)}>→</i>}
                  <span class:list={['mdl in', { lead: i === 0 }]} style={io(0.56 + i * 0.05, 0.6 + i * 0.05)}><small>{i === 0 ? 'first' : `backup ${i}`}</small>{short(m)}</span>
                </>
              ))}
            </p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Every night, an AI picks a new UK town and trade to search.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>It never repeats a town. Three free models back each other up.</p>
      </div>
    </section>

    <!-- 1 · Find: the places -->
    <section class="layer" id="scan">
      <div class="center safe">
        <div class="sc">
          <div class="map in" style={io(0.02, 0.08)}>
            <svg class="streets" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path class="river" d="M-5 78 C 20 70, 35 88, 60 76 S 90 62, 105 70" />
              <path d="M0 40 H100 M0 18 C 30 22, 60 12, 100 20 M30 0 V100 M62 0 C 58 40, 70 60, 64 100 M0 60 C 30 56, 50 64, 100 50 M85 0 V100 M12 0 C 16 50, 8 70, 14 100" />
            </svg>
            <p class="map-t">{fx.pick.trade} · {fx.pick.city}</p>
            {fx.places.map((pl, i) => (
              <span class:list={['pin in', { hero: pl.hero, dupe: pl.dupe }]} style={`${io(0.08 + i * 0.018, 0.11 + i * 0.018)};left:${pl.x}%;top:${pl.y}%`}>
                <i></i>{pl.dupe && <b class="x in" style={io(0.6, 0.64)}>✕</b>}
              </span>
            ))}
          </div>
          <div class="look">
            <p class="who in" style={io(0.06, 0.1)}>Search · Foursquare</p>
            <p class="qline in" style={io(0.08, 0.12)}><code>{fx.pick.trade} · near {fx.pick.city} {fx.pick.country} · limit {film.places.limit}</code></p>
            <p class="who in" style={io(0.34, 0.38)}>Then a second lookup · within {film.places.radius} m</p>
            <div class="biz in hit" style={io(0.36, 0.42)}>
              <b>{lead.business}</b>
              <span><Icon name="phone" />{lead.phone} <small>{film.places.telFormat}</small></span>
              <span><Icon name="route" />{lead.address.replace(', United Kingdom', '')}</span>
            </div>
            <p class="dd in" style={io(0.62, 0.68)}><b>{fx.places.filter((p) => p.dupe).length} duplicates</b> flagged “{film.dupe}” · deleted</p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Up to {film.places.limit} local businesses per search, straight from Foursquare.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>A second lookup adds the phone and address. Duplicates get deleted.</p>
      </div>
    </section>

    <!-- 2 · Owner: the research -->
    <section class="layer" id="owner">
      <div class="center safe">
        <div class="ow">
          <div class="ow-l">
            <div class="lead in" style={io(0.03, 0.08)}>
              <p class="who">Lead · from the finder</p>
              <b>{lead.business}</b>
              <span>{lead.address.replace(', United Kingdom', '')}</span>
              <p class="pc in" style={io(0.1, 0.14)}>postcode <code class="hit-text" data-pc="0">…</code><small>the workflow’s own regex, run in your browser · <b data-live="pc-ms">…</b></small></p>
            </div>
            <ol class="ladder">
              {ladder.map((q, i) => (
                <li class:list={['rung in', { skip: i > 0 }]} style={io(0.18 + i * 0.06, 0.22 + i * 0.06)}>
                  <p class="r-n">Search {i + 1}</p>
                  <code>{q}</code>
                  {i === 0
                    ? <p class="r-out ok in" style={io(0.26, 0.3)}>→ {lead.owner} · {lead.title} · Companies House</p>
                    : <p class="r-out in" style={io(0.4, 0.44)}>not needed · it already has a name</p>}
                </li>
              ))}
            </ol>
          </div>
          <div class="ow-r">
            <p class="who in" style={io(0.5, 0.54)}>Rejected</p>
            {fx.rejected.map(([n, w, why], i) => (
              <p class="rej in" style={io(0.52 + i * 0.05, 0.56 + i * 0.05)}><b>✕</b><span>{n}<small>{w}</small></span><em>{why}</em></p>
            ))}
            <blockquote class="in" style={io(0.62, 0.66)}>“{film.owner.town}”<br />“{film.owner.dissolved}”</blockquote>
            <p class="found in hit" style={io(0.7, 0.76)}><Icon name="verify" /><b>{lead.owner}</b><span>{lead.title} · {lead.business}</span></p>
            <p class="chips left">
              <span class="chip in" style={io(0.3, 0.34)}>own search engine · {film.owner.engines.join(' · ')} · {film.owner.region}</span>
              <span class="chip in" style={io(0.32, 0.36)}>{short(film.owner.model)}</span>
            </p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>An AI researcher finds the owner, one precise search at a time.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>It stops at a name and a role. Wrong town or dissolved? Rejected.</p>
      </div>
    </section>

    <!-- 2 · Owner: the email, and the fork -->
    <section class="layer" id="email">
      <div class="center safe">
        <div class="em">
          <div class="hunter in" style={io(0.04, 0.1)}>
            <p class="who">Hunter · domain search</p>
            <code>{lead.domain}</code>
            <p class="chips">{film.email.departments.map((d) => <span class="chip hot">{d}</span>)}<span class="chip">up to {film.email.limit}</span></p>
          </div>
          <div class="fork">
            <svg class="fork-w" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <path class="in" d="M0 50 C 50 50, 50 18, 100 18" style={io(0.2, 0.26)} />
              <path class="in no" d="M0 50 C 50 50, 50 82, 100 82" style={io(0.5, 0.56)} />
            </svg>
            <div class="lanes">
              <div class="lane ok in hit" style={io(0.26, 0.32)}>
                <p class="l-top"><Icon name="reply" /><b>{lead.email}</b></p>
                <p class="l-sub">{lead.owner} · {fx.hunter[0].dept} ✓</p>
                <p class="l-to">→ website audit · inbox check · outreach</p>
              </div>
              <div class="lane no in hit" style={io(0.56, 0.62)}>
                <p class="l-top"><Icon name="phone" /><b>{fx.caller.business}</b></p>
                <p class="l-sub">no website · no email found</p>
                <p class="l-to">→ the AI caller</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Hunter finds their email, from management only.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>Email found? It goes to outreach. None? It gets a phone call.</p>
      </div>
    </section>

    <!-- 3 · Audit: pages and screenshots -->
    <section class="layer" id="pages">
      <div class="center safe">
        <div class="pg">
          <div class="pg-top">
            <div class="smap in" style={io(0.04, 0.1)}>
              <p class="who">GET /sitemap.xml</p>
              <p><span>{lead.domain}</span><b data-sm="0">…</b></p>
              <p class="dim"><span>a site without one · 404 page</span><b data-sm="1">…</b></p>
              <small>under {film.audit.maxMb} MB · <span data-live="sm-ms">…</span> in your browser</small>
            </div>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.14, 0.18)} /></svg>
            <div class="ai in hit" style={io(0.16, 0.22)}><Icon name="search" /><b>Gemini picks 3 pages</b><span>{passes[0].model}</span></div>
            <svg class="arr" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.22, 0.26)} /></svg>
            <ol class="roles">
              {fx.pages.map((pg, i) => <li class="in" style={io(0.26 + i * 0.03, 0.3 + i * 0.03)}><b>{pg.role}</b><code>{pg.path}</code></li>)}
            </ol>
          </div>
          <div class="shots">
            {fx.pages.map((pg, i) => (
              <figure class="pair">
                <div class="frame d in" style={io(0.4 + i * 0.06, 0.44 + i * 0.06)}>
                  <p class="s-nav"><b>K&amp;P</b><span></span><span></span><span></span><em>0113 496 0472</em></p>
                  <p class:list={['s-hero', `v${i}`]}></p>
                  <p class="s-row"><i></i><i></i><i></i></p>
                </div>
                <div class="frame m in" style={io(0.42 + i * 0.06, 0.46 + i * 0.06)}>
                  <p class="s-nav"><b>K&amp;P</b><u>≡</u></p>
                  <p class:list={['s-hero', `v${i}`]}></p>
                  <p class="s-row"><i></i></p>
                </div>
                <figcaption class="in" style={io(0.44 + i * 0.06, 0.48 + i * 0.06)}>{pg.path} · desktop + mobile</figcaption>
              </figure>
            ))}
          </div>
          <p class="count in hit-text" style={io(0.6, 0.66)}>{film.audit.shots} screenshots · from its own screenshot server</p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Before any email goes out, AI audits their website.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>Three key pages, captured on desktop and on mobile.</p>
      </div>
    </section>

    <!-- 3 · Audit: three passes, one problem -->
    <section class="layer" id="verify">
      <div class="center safe">
        <div class="vf">
          <div class="vf-l">
            <ol class="pass-row">
              {passes.slice(1).map((ps, i) => (
                <li class="ps in" style={io(0.04 + i * 0.22, 0.08 + i * 0.22)}><b>{i + 1} · {ps.job}</b><span>{ps.model}{ps.temp !== null && ` · temp ${ps.temp}`}</span></li>
              ))}
            </ol>
            <div class="rules">
              {passes.slice(1).map((ps, i) => <q class="io" style={io(0.06 + i * 0.22, 0.1 + i * 0.22, i < 2 ? 0.24 + i * 0.22 : 2, i < 2 ? 0.27 + i * 0.22 : 2)}>{ps.rule}</q>)}
            </div>
            <ul class="issues">
              {fx.review.map((r, i) => (
                <li class:list={['iss in', { cut: !r.keep, pick: i === chosen }]} style={`${io(0.1 + i * 0.025, 0.13 + i * 0.025)}`}>
                  <span>{r.t}</span>
                  {!r.keep && <em class="in" style={io(0.32 + i * 0.02, 0.35 + i * 0.02)}>removed · {r.why}</em>}
                  {i === chosen && <em class="win in" style={io(0.52, 0.56)}>the one that costs leads</em>}
                </li>
              ))}
            </ul>
          </div>
          <dl class="verdict in hit" style={io(0.58, 0.64)}>
            <p class="who">The audit’s result · {film.audit.fields} fields</p>
            {[['Page', A.page], ['Problem', A.problem.replace(/^on mobile, t/, 'On mobile, t')], ['Visitor', A.reason], ['Cost', A.consequence], ['Fix', A.fix.replace(/^a/, 'A')], ['Subject', A.subject]].map(([k, v], i) => (
              <div class="in" style={io(0.62 + i * 0.025, 0.65 + i * 0.025)}><dt>{k}</dt><dd>{v}</dd></div>
            ))}
          </dl>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Three AI passes. Each deletes what it can’t see in the screenshots.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>What survives is one real problem, worth an email.</p>
      </div>
    </section>

    <!-- 4 · Inbox: who hosts it -->
    <section class="layer" id="inbox">
      <div class="center safe">
        <div class="ib">
          <div class="hosts">
            {fx.hosts.map((h, i) => {
              const bad = h.host === film.inbox.blocked;
              return (
                <p class:list={['h-r in', { bad }]} style={`${io(0.06 + i * 0.03, 0.1 + i * 0.03)};--k:${0.44 + i * 0.03}`}>
                  <span class="h-e">{h.e}</span>
                  <b class="h-h in" style={io(0.22 + i * 0.03, 0.26 + i * 0.03)}>{h.host}</b>
                  <em class="h-v in hit-text" style={io(0.44 + i * 0.03, 0.48 + i * 0.03)}>{bad ? '✕ skipped' : '✓ send'}</em>
                </p>
              );
            })}
          </div>
          <div class="rule-card in" style={io(0.36, 0.42)}>
            <p class="who">The rule</p>
            <code>inbox host = “{film.inbox.blocked}”<br />→ skip</code>
            <small>looked up per address · {film.inbox.service}</small>
            <p class="shield in hit" style={io(0.66, 0.72)}><Icon name="lock" />domain reputation protected</p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Every address gets checked: who hosts this inbox?</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>Hosts that land us in spam are skipped. The domain stays clean.</p>
      </div>
    </section>

    <!-- 5 · Outreach: the email and the pace -->
    <section class="layer" id="send">
      <div class="center safe">
        <div class="sd">
          <article class="mail in" style={io(0.04, 0.1)}>
            <p class="m-h"><span>To</span>{lead.email}</p>
            <p class="m-h"><span>Subject</span><b>{first.subject}</b></p>
            <div class="m-b">
              {first.body.map((para, i) => (
                <p class:list={['in', `p${i}`]} style={io(0.1 + i * 0.03, 0.14 + i * 0.03)}>{marked(para).map((s) => s.m ? <mark class="hit-text">{s.t}</mark> : s.t)}</p>
              ))}
            </div>
            <p class="m-note in" style={io(0.34, 0.38)}><mark>highlighted</mark> written by the website audit</p>
          </article>
          <div class="queue">
            <p class="who in" style={io(0.5, 0.54)}>Send queue · one at a time</p>
            {fx.queue.map((q, i) => (
              <p class="qr in" style={io(0.54 + i * 0.04, 0.58 + i * 0.04)}><time data-at={i}>…</time><span>{q}</span><b data-gap={i}>…</b></p>
            ))}
            <p class="chip in" style={io(0.76, 0.8)}>stop switch checked before every send</p>
            <p class="stamp in" style={io(0.78, 0.82)}>The real spacing code ran in your browser · <b data-live="gap-ms">…</b></p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>Each email opens with the real problem on their own site.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>One at a time, a random {sMin} to {sMax} minutes apart.</p>
      </div>
    </section>

    <!-- 5 · Outreach: follow-ups and the reply checker -->
    <section class="layer" id="replies">
      <div class="center safe">
        <div class="rp">
          <ol class="days">
            {film.outreach.emails.map((e, i) => (
              <li class="day in" style={io(0.04 + i * 0.06, 0.08 + i * 0.06)}>
                <p class="d-n">Day {days[i]}</p>
                <p class="d-k">{e.kind}</p>
                <p class="d-t">{i === 0 ? first.subject : `“${follow[i - 1]}”`}</p>
                <p class="d-w">{i === 0 ? 'new thread' : 'same thread'} · then reads it after {film.outreach.waits[i]}</p>
              </li>
            ))}
          </ol>
          <div class="threads">
            {fx.threads.map((t, i) => {
              const last = t.messages[t.messages.length - 1];
              const hdr = last.payload.headers[0];
              return (
                <div class="th in" data-thread style={io(0.4 + i * 0.07, 0.44 + i * 0.07)}>
                  <p class="who">{t.who}</p>
                  <p class="th-s">{t.messages.length > 1 ? `“${last.snippet}”` : 'no answer yet'}</p>
                  {hdr && <p class="th-h">header · {hdr.name}: {hdr.value}</p>}
                  <p class="th-r hit-text in" style={io(0.46 + i * 0.07, 0.5 + i * 0.07)}><b data-reply={i}>…</b><span class="th-o"></span></p>
                </div>
              );
            })}
          </div>
          <p class="stamp in" style={io(0.66, 0.7)}>The workflow’s reply checker ran in your browser · <b data-live="reply-ms">…</b> · {film.outreach.keywords} out-of-office phrases + {film.outreach.headers.length} email headers</p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.4, 0.44)}>Up to three follow-ups, each in the same thread.</p>
        <p class="narr io" style={io(0.48, 0.54, 0.93, 0.97)}>Before each one, it reads the thread. A real reply or an out-of-office stops it.</p>
      </div>
    </section>

    <!-- 6 · Call: no email, so it rings -->
    <section class="layer" id="call">
      <div class="center safe">
        <div class="cl">
          <div class="cl-l">
            <div class="lead in" style={io(0.03, 0.08)}>
              <p class="who">Lead · no email</p>
              <b>{fx.caller.business}</b>
              <span>no website · owner unknown to email</span>
            </div>
            <div class="res in" style={io(0.08, 0.13)}>
              <p class="who">Research · Perplexity {film.call.researchModel}</p>
              <ul>{film.call.research.map((r, i) => <li class="in" style={io(0.12 + i * 0.025, 0.15 + i * 0.025)}>✓ {r}</li>)}</ul>
            </div>
          </div>
          <dl class="profile in hit" style={io(0.26, 0.32)}>
            <p class="who">Profile · {film.call.profileModel} · {film.call.maxWords.toLowerCase()}</p>
            {Object.entries(fx.caller.profile).map(([k, v], i) => (
              <div class="in" style={io(0.3 + i * 0.02, 0.33 + i * 0.02)}><dt>{k}</dt><dd>{v}</dd></div>
            ))}
            <p class="p-rule">“{film.call.noInvent}”</p>
          </dl>
          <div class="cl-r">
            <div class="ring-call in" style={io(0.5, 0.56)}>
              <p class="who"><Icon name="phone" />AI voice · {film.call.voiceModel.replace(/-\d{4}-\d\d-\d\d$/, '')}</p>
              <p class="said-s" data-type="0.54 0.64">{film.call.opener}</p>
            </div>
            <blockquote class="in" style={io(0.62, 0.66)}>“{film.call.reveal}”<small>from its {film.call.scriptChars.toLocaleString('en-GB')}-character script</small></blockquote>
            <p class="booked in hit" style={io(0.72, 0.78)}><b>Booked</b><span>calendar · CRM · SMS · Telegram</span></p>
            <a class="more in" style={io(0.8, 0.84)} href="/film/ai-cold-caller/">The full call engine: AI Cold Caller ▸</a>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.46, 0.5)}>No email? It researches the owner and writes a one-glance profile.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>Then an AI voice calls. A booked call lands straight in the calendar.</p>
      </div>
    </section>

    <!-- The machine: all seven, as built -->
    <section class="layer" id="machine">
      <div class="center safe">
        <div class="wall">
          {wfs.map((w, i) => (
            <figure class="w-tile in" style={io(0.04 + i * 0.04, 0.1 + i * 0.04)}>
              <div class="w-img"><Picture src={shotOf(w.slug)} alt={`${w.title} as built in the n8n editor`} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 800]} sizes="(min-width: 761px) 280px, 170px" loading="lazy" decoding="async" /></div>
              <figcaption>{w.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="m-cap">
        <p class="meta io" style={io(0.5, 0.56)}>The machine · as built, in the n8n editor</p>
        <p class="m-facts io" style={io(0.56, 0.64)}><span>{film.totals.workflows} workflows</span><span>{wfs.reduce((n, w) => n + w.stats.nodes, 0)} nodes</span><span>{film.totals.agents} AI agents</span><span>{film.totals.services} services</span></p>
      </div>
    </section>

    <section class="layer hold-end" id="end">
      <div class="center">
        <div class="end">
          <p class="fin">— Fin —</p>
          <p class="next">Next feature</p>
          <a class="go" href="/film/ai-cold-caller/">AI Cold Caller ▶</a>
          <a class="lobby" href="/">Back to the lobby</a>
        </div>
      </div>
    </section>
  </div>

  <LeadMap stops={STOPS} mode="mini" />

  <div class="track" aria-hidden="true">
    {SCENES.map(([id, len, ch]) => <div data-scene={id} data-chapter={ch} style={`--len:${len}`}></div>)}
  </div>
  <script type="application/json" id="live-source" set:html={JSON.stringify(liveSource)} />
  <script type="application/json" id="live-fixtures" set:html={JSON.stringify(liveFixtures)} />
</Film>

<style>
