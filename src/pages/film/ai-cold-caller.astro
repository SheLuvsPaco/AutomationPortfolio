  .bub { justify-self: start; max-width: 44rem; display: flex; align-items: baseline; gap: 10px; padding: 6px 12px; border-radius: 12px 12px 12px 3px; background: #1b1e23; font-size: 0.84rem; line-height: 1.35; }
  .bub b { flex: none; font-size: 0.56rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3); }
  .bub.b { background: #26150f; border: 1px solid rgb(255 107 61 / 0.4); }
  .bub.b b { color: var(--live); }
  .turn:not(.me) .bub { border-radius: 12px 12px 3px 12px; background: #1d2a1f; }
  .turn:not(.me) .bub b { color: #7fd6a4; }
