    .vd-out .vraw { display: none; }

    .fl { grid-template-columns: 1fr 1fr; gap: 8px; }
    .cal-c, .sms, .tg { padding: 10px 12px; }
    .cal-d { font-size: 1rem; }
    .tg { display: none; }
    .sm { font-size: 0.7rem; }
    .rest { grid-column: 1 / -1; justify-items: center; }
    .not { text-align: center; }
  }
</style>
