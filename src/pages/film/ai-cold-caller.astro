  .lg { display: grid; grid-template-columns: 5.4em 1fr auto 6.6em; gap: 14px; align-items: baseline; padding: 6px 0; border-top: 1px solid #1a1d21; font-family: var(--mono); font-size: 0.8rem; }
  .lg:first-child { border-top: 0; }
  .lg time { color: var(--text-3); }
  .lg span { color: var(--text-2); }
