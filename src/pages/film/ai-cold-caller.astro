    .br-l { opacity: calc(1 - clamp(0, (var(--p) - 0.44) / 0.04, 1)); }
    .br-l, .doc { grid-area: 1 / 1; }

    .dl-w { grid-template-columns: 1fr; gap: 12px; }
    .body { padding: 10px 12px; }
