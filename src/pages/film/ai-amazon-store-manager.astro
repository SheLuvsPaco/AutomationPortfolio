---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Film from '../../layouts/Film.astro';
import Icon from '../../components/Icon.astro';
import TeamMap, { type Station } from '../../components/TeamMap.astro';
import { index } from '../../lib/data';
import film from '../../data/generated/amazon.film.json';
import fx from '../../film/amazon-fixtures.json';

const STATIONS: Station[] = [
  { step: 'Research', sub: 'autocomplete · scraper', slugs: ['fba-research'] },
  { step: 'Listing', sub: 'seller API · AI rewrite', slugs: ['listing-manager-1', 'listing-manager-2', 'listing-manager-3'] },
  { step: 'Ads', sub: 'campaigns via Ads API', slugs: ['ppc-auto', 'ppc-manual'] },
  { step: 'Reports', sub: 'sales · campaigns · ads', slugs: ['daily-report', 'weekly-report', 'daily-campaign-report', 'weekly-campaign-report', 'ads-campaign-report'] },
  { step: 'Optimize', sub: 'keyword rotation · AI', slugs: ['keywords-update-new', 'update-keywords'] },
];
const amz = index.filter((w) => w.folder === 'amazon-fba');
const nodes = amz.reduce((s, w) => s + w.stats.nodes, 0);
const agents = amz.reduce((s, w) => s + w.stats.agents, 0);
const services = new Set(amz.flatMap((w) => w.stats.integrations)).size;
const titleOf = Object.fromEntries(amz.map((w) => [w.slug, w.title]));
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/shots/amz-*.png', { eager: true });
const shotOf = (slug: string) => shots[`../../assets/shots/amz-${slug}.png`].default;

// Research: the tree the autocomplete grows, from the parser's kept keywords.
const kept = film.suggestions.filter(([, ok]) => ok).map(([v]) => v as string);
const tree = kept.map((k, i) => ({ k, y: 30 + i * 74, kids: (fx.rounds.find(([p]) => p === k)?.[1] as string[]) ?? [] }));

// Gaps: price × reviews (log), the scraper filter's zone.
const P = { x0: 76, x1: 700, y0: 24, y1: 330, pMax: 80, rMin: 10, rMax: 5000 };
const px = (p: number) => P.x0 + (p / P.pMax) * (P.x1 - P.x0);
const py = (r: number) => P.y1 - ((Math.log10(Math.max(r, P.rMin)) - 1) / (Math.log10(P.rMax) - 1)) * (P.y1 - P.y0);
const passCount = film.products.filter((p) => p[3]).length;

// Ads: the proven three from the last report (Manual campaigns, by sales).
const proven = fx.searchTerms.filter((r) => r.campaignName.includes('Manual')).sort((a, b) => b.sales7d - a.sales7d).slice(0, 3).map((r) => r.keyword);
// Optimize: rows the keywords agent's waste rule would flag (≥ 12 clicks, no sales, ≥ $15).
const isWaste = (r: (typeof fx.searchTerms)[number]) => r.clicks >= 12 && r.sales7d === 0 && r.spend >= 15;
const usd = (n: number) => `$${n.toFixed(2)}`;

const liveSource = film.live;
const liveFixtures = { listingTsv: fx.listingTsv, searchTerms: fx.searchTerms, salesAndTraffic: fx.salesAndTraffic };
const tsvShown = fx.listingTsv.replaceAll('\t', '  ⇥ ');
const listingFirst = film.listingMessage.split('\n').slice(0, 9).join('\n').trim();
const fields = [['item-name', 'title'], ['price', 'price'], ['open-date', 'listed since'], ['status', 'status'], ['fulfillment-channel', 'fulfilment']];

// The report run, as a log. Times and ids are invented; the calls, the
// statuses and the 10-minute wait are the workflow's own.
const runLog: [string, string, string, boolean?][] = [
  ['09:00:02', `POST /reporting/reports · ${film.report.type} · ${film.report.format}`, '→ reportId'],
  ['09:00:03', 'GET /reporting/reports/{id}', '→ PENDING'],
  ['09:10:03', `wait ${film.waits[1]} · GET /reporting/reports/{id}`, '→ PROCESSING'],
  ['09:20:04', `wait ${film.waits[1]} · GET /reporting/reports/{id}`, '→ COMPLETED', true],
  ['09:20:05', 'GET {url} · download', '→ report.json.gz'],
  ['09:20:06', 'decompress · extract from file', `→ rows · ${film.report.columns.length} columns`, true],
];

const STEPS = STATIONS.map((s) => s.step);
const SCENES = [
  ['open', 130], ['problem', 330], ['fix', 320],
  ['suggest', 300, 'Research'], ['gaps', 280, 'Research'], ['pull', 240, 'Listing'], ['rewrite', 330, 'Listing'],
  ['build', 320, 'Ads'], ['wait', 260, 'Reports'], ['phone', 330, 'Reports'], ['rotate', 340, 'Optimize'],
  ['machine', 300], ['end', 150],
] as const;
const io = (a: number, b: number, c = 2, dd = 2) => `--a:${a};--b:${b};--c:${c};--d:${dd}`;
const tiles = (yours: number) => Array.from({ length: 8 }, (_, i) => i === yours);
---
<Film
  title="Online Store That Runs Itself · Plamen Iliev"
  film="Online Store That Runs Itself"
  description="A short film about thirteen n8n workflows that research, list, advertise, report and re-optimise an Amazon FBA store."
  runtime={200}
  steps={STEPS}
>
  <div class="stage">
    <section class="layer hold-start on" id="open">
      <div class="center">
        <div class="o-wrap">
          <h1 class="title-x o-title two" style="view-transition-name: film-title; --em: 13.6; --em-m: 13.6"><span>Online Store</span> <span>That Runs Itself</span></h1>
          <p class="narr io" style={io(0.25, 0.4)}>A short film about an Amazon store run by thirteen workflows.</p>
          <p class="invented io" style={io(0.4, 0.55)}>Fictional numbers. Real machines.</p>
        </div>
      </div>
      <p class="cue">Scroll to play</p>
    </section>

    <!-- The problem -->
    <section class="layer" id="problem">
      <p class="kicker io" style={io(0.02, 0.08)}>The problem</p>
      <div class="center safe">
        <div class="pb io" style={io(0, 0.01, 0.74, 0.8)}>
          <div class="serp">
            <p class="serp-q"><Icon name="search" /><span>{fx.problem.query}</span></p>
            <div class="pages">
              <p class="pg io" style={io(0, 0.01, 0.28, 0.32)}><span class="on">1</span><span>2</span><span>3</span><span>4</span></p>
              <p class="pg in" style={io(0.3, 0.34)}><span>1</span><span>2</span><span class="on">3</span><span>4</span></p>
            </div>
            <div class="grids">
              {[0, 6].map((yours, gi) => (
                <div class="grid io" style={gi ? io(0.3, 0.36) : io(0, 0.01, 0.26, 0.32)}>
                  {tiles(yours).map((y) => (
                    <div class:list={['tile', { yours: y, sunk: y && gi }]}>
                      <i></i><b></b><b class="s"></b>
                      {y && <span class="tag">{gi ? 'yours · page 3' : 'yours'}</span>}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="clicks">
            <p class="who in" style={io(0.38, 0.42)}>Ad clicks it paid for</p>
            {fx.problem.wasted.map(([term, cost], i) => (
              <p class="click in" style={io(0.42 + i * 0.045, 0.46 + i * 0.045)}><span>“{term}”</span><b>{usd(cost as number)}</b><em>0 orders</em></p>
            ))}
          </div>
        </div>
        <figure class="brief in" style={io(0.8, 0.86)}>
          <figcaption>The brief inside the AI agents’ prompts</figcaption>
          <blockquote>“{film.brief[0]}<br />{film.brief[1]}”</blockquote>
        </figure>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.3, 0.34)}>It used to rank on page 1. Then it sank to page 3.</p>
        <p class="narr io" style={io(0.4, 0.46, 0.72, 0.76)}>And the ads kept paying for clicks that never bought.</p>
        <p class="narr io" style={io(0.84, 0.88, 0.95, 0.98)}>That is the brief the AI agents work from.</p>
      </div>
    </section>

    <!-- The fix: the team -->
    <section class="layer" id="fix">
      <p class="kicker io" style={io(0.02, 0.08)}>The fix · 13 real workflows</p>
      <div class="center safe"><TeamMap stations={STATIONS} mode="big" /></div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.52, 0.56)}>Thirteen workflows, split like a store team.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>One shared memory. Each run starts where the last one stopped.</p>
      </div>
    </section>

    <!-- 1 · Research: Amazon's own search box -->
    <section class="layer" id="suggest">
      <div class="center safe">
        <div class="sg">
          <div class="sg-left">
            <p class="sbox"><Icon name="search" /><span data-type="0.04 0.12">{fx.seed}</span></p>
            <ul class="drop">
              {film.suggestions.map(([v, ok, why], i) => (
                <li class:list={['in', ok ? 'ok' : 'no']} style={io(0.12 + i * 0.022, 0.16 + i * 0.022)}>
                  <span class="v">{v}</span>
                  <b class="mark in" style={io(0.36 + i * 0.022, 0.4 + i * 0.022)}>{ok ? '✓ kept' : `✕ ${why}`}</b>
                </li>
              ))}
            </ul>
          </div>
          <div class="sg-right">
            <p class="chips">
              <span class="chip in" style={io(0.04, 0.08)}>GET {film.suggestHost}</span>
              <span class="chip hot in" style={io(0.32, 0.36)}>{film.maxWords}</span>
              <span class="chip hot in" style={io(0.58, 0.62)}>{film.roundsLine}</span>
            </p>
            <p class="rounds in" style={io(0.6, 0.64)}><small>round</small><span data-count="0.62 0.9" data-to={film.rounds}>{film.rounds}</span><small>of {film.rounds}</small></p>
            <svg class="tree" viewBox="0 0 520 300" aria-label="Each kept keyword becomes the next search">
              {tree.map((n, i) => (
                <g class="in" style={io(0.62 + i * 0.03, 0.66 + i * 0.03)}>
                  <path class="br" d={`M8 150 C 70 150, 60 ${n.y}, 120 ${n.y}`} />
                  <text class="t1" x="128" y={n.y + 5}>{n.k}</text>
                  {n.kids.map((c, j) => {
                    const cy = n.y - 12 + j * 22;
                    return (
                      <g class="in" style={io(0.72 + i * 0.03 + j * 0.02, 0.76 + i * 0.03 + j * 0.02)}>
                        <path class="br2" d={`M300 ${n.y} C 322 ${n.y}, 318 ${cy}, 340 ${cy}`} />
                        <text class="t2" x="346" y={cy + 4}>{c}</text>
                      </g>
                    );
                  })}
                </g>
              ))}
              <circle class="root" cx="8" cy="150" r="5" />
            </svg>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.52, 0.56)}>It asks Amazon’s own search box what shoppers type.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Then asks again about every answer it keeps.</p>
      </div>
    </section>

    <!-- 1 · Research: the openings -->
    <section class="layer" id="gaps">
      <div class="center safe">
        <div class="gp">
          <p class="chips">
            <span class="chip in" style={io(0.02, 0.06)}>POST {film.scraperHost} · {film.scraperTarget}</span>
            <span class="chip hot in" style={io(0.28, 0.32)}>{film.filterLine}</span>
            <span class="chip kept in" style={io(0.5, 0.56)}><b>{passCount}</b> of {film.products.length} kept</span>
          </p>
          <svg class="plot" viewBox="0 0 720 380" aria-label={`${film.products.length} products by price and reviews; ${passCount} fall inside the filter`}>
            <rect class="zone draw-zone" x={px(30)} y={py(150)} width={P.x1 - px(30)} height={P.y1 - py(150)} style={io(0.3, 0.38)} />
            <text class="zone-t in" x={P.x1 - 12} y={P.y1 - 14} text-anchor="end" style={io(0.36, 0.42)}>the openings</text>
            <line class="ax" x1={P.x0} x2={P.x1} y1={P.y1} y2={P.y1} />
            <line class="ax" x1={P.x0} x2={P.x0} y1={P.y0} y2={P.y1} />
            {[0, 20, 40, 60, 80].map((p) => <text class="tk" x={px(p)} y={P.y1 + 22} text-anchor="middle">${p}</text>)}
            {[10, 100, 1000].map((r) => <text class="tk" x={P.x0 - 10} y={py(r) + 4} text-anchor="end">{r}</text>)}
            <text class="lab" x={P.x1} y={P.y1 + 46} text-anchor="end">price</text>
            <text class="lab" x={P.x0 - 10} y={P.y0 - 8} text-anchor="end">reviews</text>
            {film.products.map(([price, rev, paid, pass], i) => (
              <circle class:list={['dot in', { paid, pass }]} cx={px(price)} cy={py(rev)} r="9" style={io(0.06 + i * 0.01, 0.1 + i * 0.01)} />
            ))}
          </svg>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.4, 0.46)}>Then it scrapes the search results.</p>
        <p class="narr io" style={io(0.5, 0.56, 0.93, 0.97)}>And keeps only the openings: over $30, under 150 reviews.</p>
      </div>
    </section>

    <!-- 2 · Listing: straight from the seller API -->
    <section class="layer" id="pull">
      <div class="center safe">
        <div class="pu">
          <p class="chips">
            <span class="chip in" style={io(0.02, 0.06)}>POST /reports · {film.listingReport}</span>
            <span class="chip in" style={io(0.08, 0.12)}>waits for {film.statuses[0]} · stops on {film.statuses.slice(1).join(' or ')}</span>
            <span class="chip in" style={io(0.14, 0.18)}>every call SigV4-signed</span>
          </p>
          <div class="pu-row">
            <pre class="tsv in" style={io(0.2, 0.26)}>{tsvShown}</pre>
            <svg class="pu-arrow" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path class="draw" pathLength="1" d="M0 10 H100" style={io(0.34, 0.4)} /></svg>
            <dl class="parsed in" style={io(0.4, 0.46)}>
              {fields.map(([k, label], i) => (
                <div class="in" style={io(0.44 + i * 0.035, 0.48 + i * 0.035)}><dt>{label}</dt><dd data-tsv={k}>…</dd></div>
              ))}
            </dl>
          </div>
          <p class="stamp in" style={io(0.66, 0.72)}>The workflow’s real report parser ran in your browser · <b data-live="tsv-ms">…</b></p>
        </div>
      </div>
      <div class="subs"><p class="narr io" style={io(0.06, 0.12, 0.93, 0.97)}>It pulls the live listing straight from Amazon’s seller API.</p></div>
    </section>

    <!-- 2 · Listing: the rewrite -->
    <section class="layer" id="rewrite">
      <div class="center safe">
        <div class="rw">
          <p class="agent-bar in" style={io(0.02, 0.08)}><Icon name="verdict" /><b>AI agent</b><span>gpt-4.1-nano · Perplexity sonar-pro · database tool</span><em class="invented">example output from its prompt</em></p>
          <div class="lst">
            <p class="who">Listing title</p>
            <p class="old">Gold Cake Stand Set</p>
            <p class="new" data-type="0.2 0.38">{film.example.title}</p>
            <ul class="bul">
              {film.example.bullets.slice(0, 3).map((b, i) => <li class="in" style={io(0.4 + i * 0.04, 0.44 + i * 0.04)}>{b}</li>)}
            </ul>
            <div class="neg">
              <p class="who in" style={io(0.6, 0.64)}>Never pay for</p>
              <p class="neg-chips">
                {film.example.negatives.slice(0, 8).map((n, i) => <span class="chip no in hit" style={io(0.58 + i * 0.014, 0.62 + i * 0.014)}>⊘ {n}</span>)}
              </p>
            </div>
          </div>
          <div class="after">
            <p class="quote io" style={io(0.72, 0.78, 0.86, 0.9)}>“{film.negativesRule}”<small>from its prompt</small></p>
            <p class="retry in" style={io(0.88, 0.92)}><span class="chip hot hit">Product Manager-2</span>reads why the last edit failed, and tries again</p>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.56, 0.6)}>An AI studies the competition, then rewrites the listing.</p>
        <p class="narr io" style={io(0.62, 0.68, 0.93, 0.97)}>And it names the searches you should never pay for.</p>
      </div>
    </section>

    <!-- 3 · Ads: the campaign, layer by layer -->
    <section class="layer" id="build">
      <div class="center safe">
        <div class="bd">
          <div class="nest">
            <div class="box camp in" style={io(0.04, 0.1)}>
              <p class="ep">POST {film.ads.endpoints[0].replace(/^[^/]+/, '')}</p>
              <p class="bx-t">Campaign</p>
              <p class="bx-f">{film.ads.campaign.targetingType} · {usd(film.ads.campaign.budget)} {film.ads.campaign.budgetType} · {film.ads.campaign.campaignType}</p>
              <div class="box grp in" style={io(0.16, 0.22)}>
                <p class="ep">POST {film.ads.endpoints[1].replace(/^[^/]+/, '')}</p>
                <p class="bx-t">Ad group</p>
                <p class="bx-f">default bid {usd(film.ads.defaultBid)}</p>
                <div class="pair">
                  <div class="box ad in" style={io(0.28, 0.34)}>
                    <p class="ep">POST {film.ads.endpoints[2].replace(/^[^/]+/, '')}</p>
                    <p class="bx-t">Product ad</p>
                    <p class="bx-f">the product’s SKU</p>
                  </div>
                  <div class="box kws in" style={io(0.4, 0.46)}>
                    <p class="ep">POST {film.ads.endpoints[3].replace(/^[^/]+/, '')}</p>
                    <p class="bx-t">{film.ads.keywords.count} keywords · {film.ads.keywords.matchType} · {usd(film.ads.keywords.bid)}</p>
                    <p class="kw-chips">
                      {proven.map((k, i) => <span class="chip hot in" style={io(0.48 + i * 0.02, 0.52 + i * 0.02)}>★ {k}</span>)}
                      {fx.aiSelected.map((k, i) => <span class:list={['chip in', { extra: i > 2 }]} style={io(0.56 + i * 0.015, 0.6 + i * 0.015)}>＋ {k}</span>)}
                      <span class="chip more in" style={io(0.62, 0.66)}>＋ {fx.aiSelected.length - 3} more</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <p class="also in" style={io(0.7, 0.76)}>Plus an {film.ads.autoTargeting} campaign at {usd(film.ads.autoBudget)} a day, built the same way.</p>
          </div>
          <figure class="tg in" style={io(0.78, 0.84)}>
            <figcaption>Telegram</figcaption>
            <p>{film.launched}</p>
          </figure>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.42, 0.46)}>It builds the campaign itself: campaign, ad group, ad.</p>
        <p class="narr io" style={io(0.5, 0.56, 0.93, 0.97)}>Then seeds it with three proven keywords and seven new ones.</p>
      </div>
    </section>

    <!-- 4 · Reports: Amazon makes you wait -->
    <section class="layer" id="wait">
      <div class="center safe">
        <div class="wt">
          <div class="log in" style={io(0.02, 0.06)}>
            <p class="log-h"><span>run log</span><span>Keywords Update · search-term report</span></p>
            {runLog.map(([t, call, res, hot], i) => (
              <p class:list={['log-l in', { hot }]} style={io(0.06 + i * 0.075, 0.09 + i * 0.075)}>
                <time>{t}</time><code>{call}</code><b>{res}</b>
              </p>
            ))}
          </div>
          <p class="cols">
            {film.report.columns.map((c, i) => <span class="chip in" style={io(0.56 + i * 0.015, 0.6 + i * 0.015)}>{c}</span>)}
          </p>
          <p class="chips">
            <span class="chip in" style={io(0.72, 0.76)}>waits of {film.waits.join(' · ')} across the workflows</span>
            <span class="chip hot in hit" style={io(0.8, 0.84)}>token expires mid-wait? a backup branch refreshes it and carries on</span>
          </p>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.44, 0.5)}>Amazon makes you wait for its reports.</p>
        <p class="narr io" style={io(0.54, 0.6, 0.93, 0.97)}>So it waits, checks again, then downloads and unzips.</p>
      </div>
    </section>

    <!-- 4 · Reports: on the owner's phone -->
    <section class="layer" id="phone">
      <div class="center safe">
        <div class="ph-wrap">
          <div class="rep-side">
            <ul class="rep-list">
              {STATIONS[3].slugs.map((s, i) => <li class="in" style={io(0.06 + i * 0.05, 0.1 + i * 0.05)}><i></i>{titleOf[s]}</li>)}
            </ul>
            <p class="stamp rep-stamp in" style={io(0.7, 0.76)}>The first two messages were written by the workflows’ own code, in your browser · <b data-live="msgs-ms">…</b></p>
          </div>
          <div class="phone">
            <p class="ph-head"><b>Store bot</b><span>Telegram</span></p>
            <div class="ph-msgs">
              <div class="msg in" style={io(0.14, 0.2)}><p data-live="msg-sales">…</p></div>
              <div class="msg in" style={io(0.36, 0.42)}><p data-live="msg-campaign">…</p></div>
              <div class="msg in" style={io(0.58, 0.64)}><p>{listingFirst}</p></div>
            </div>
          </div>
        </div>
      </div>
      <div class="subs">
        <p class="narr io" style={io(0.04, 0.1, 0.5, 0.56)}>Every report lands on the owner’s phone.</p>
        <p class="narr io" style={io(0.6, 0.66, 0.93, 0.97)}>Sales, ads, listings. Already written up.</p>
      </div>
    </section>

    <!-- 5 · Optimize: the rotation -->
    <section class="layer" id="rotate">
      <div class="center safe">
        <div class="rt">
          <div class="board">
            <p class="b-row b-head"><span>keyword</span><span>clicks</span><span>spend</span><span>sales 7d</span><span></span></p>
            {fx.searchTerms.map((r, i) => (
              <p class:list={['b-row in', { waste: isWaste(r), auto: !r.campaignName.includes('Manual') }]} data-kw={r.keyword} style={io(0.04 + i * 0.025, 0.08 + i * 0.025)}>
                <span>{r.keyword || `“${r.searchTerm}”`}</span><span>{r.clicks}</span><span>{usd(r.spend)}</span><span>{usd(r.sales7d)}</span><b class="tag"></b>
              </p>
            ))}
            <p class="new-kw">
              {fx.aiSelected.map((k, i) => <span class="chip hot in hit" style={io(0.6 + i * 0.022, 0.64 + i * 0.022)}>＋ {k}</span>)}
            </p>
          </div>
          <div class="rules">
