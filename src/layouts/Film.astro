---
import Shell from './Shell.astro';
import Countdown from '../components/Countdown.astro';
import '../styles/scenes.css';

interface Props {
  title: string;
  film: string;
  description: string;
  runtime: number;
  /** The system's journey, in order; scenes name their step with data-chapter. */
  steps?: string[];
}
const { title, film, description, runtime, steps = [] } = Astro.props;
---
<Shell title={title} description={description}>
  <Countdown />
  <header class="chrome" data-runtime={runtime}>
    <a class="back" href="/">← Lobby</a>
    <span class="film">{film}</span>
    <span class="tc" data-timecode aria-hidden="true">00:00</span>
    <i class="bar" data-progress aria-hidden="true"></i>
  </header>
  {steps.length > 0 && (
    <nav class="rail" data-rail aria-label="Where this scene sits in the system">
      <ol>{steps.map((s) => <li data-step={s}><i></i><span>{s}</span></li>)}</ol>
      <p class="rail-now" data-rail-now aria-hidden="true"></p>
    </nav>
  )}
  <main>
    <slot />
  </main>
</Shell>

<style>
  .chrome {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px var(--gutter) 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
    pointer-events: none;
  }
  .back { pointer-events: auto; text-decoration: none; color: var(--text-2); padding: 6px 0; }
  .back:hover { color: var(--text); }
  .film { flex: 1; min-width: 0; text-align: center; font-stretch: 125%; letter-spacing: 0.24em; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tc { font-family: var(--mono); letter-spacing: 0.04em; color: var(--text-2); }
  .bar {
    position: fixed;
    left: 0;
    top: 0;
    height: 2px;
    width: 100%;
    background: var(--live);
    transform-origin: left;
    scale: var(--g, 0) 1;
  }

  /* The journey rail: which step of the system the viewer is watching. */
  .rail {
    position: fixed;
    top: 54px;
    left: var(--gutter);
    right: var(--gutter);
    z-index: 19;
    display: grid;
    justify-items: center;
    pointer-events: none;
    opacity: 0;
    translate: 0 -6px;
    transition: opacity 0.5s var(--ease), translate 0.5s var(--ease);
  }
  .rail:global(.shown) { opacity: 1; translate: 0 0; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: flex; }
  .rail li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 8px;
    width: clamp(88px, 10vw, 132px);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #5d5b56;
    transition: color 0.4s;
  }
  /* The wire between steps, drawn behind the dots. */
  .rail li + li::before {
    content: '';
    position: absolute;
    top: 4px;
    right: 50%;
    width: 100%;
    height: 1px;
    background: #2a2d33;
    transition: background 0.4s;
  }
  .rail li i {
    position: relative;
    z-index: 1;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid #4a4d55;
    background: var(--night);
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  .rail li:global(.done) { color: var(--text-3); }
  .rail li:global(.done) i { background: var(--text-3); border-color: var(--text-3); }
  .rail li:global(.done)::before, .rail li:global(.now)::before { background: var(--text-3); }
  .rail li:global(.now) { color: var(--text); }
  .rail li:global(.now) i { background: var(--live); border-color: var(--live); box-shadow: 0 0 0 5px rgb(255 107 61 / 0.18), 0 0 18px var(--live); }
  .rail-now { display: none; }
  @media (max-width: 760px) {
    .chrome { gap: 12px; }
    .film { font-size: 0.64rem; letter-spacing: 0.1em; font-stretch: 112%; }
    .rail { top: 50px; }
    .rail ol { display: none; }
    .rail-now { display: block; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--live); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail { translate: none; }
  }
</style>

<script>
  import { startFilm } from '../film/engine';
  import { runLive } from '../film/live';
  startFilm();
  const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 200));
  idle(() => runLive());
</script>
